# ============================================================
# PawPal environment settings
# Copy this file to ".env" and fill in what you have. NEVER commit .env.
# PawPal runs locally with none of these set (file database, dev mailbox,
# dev SMS log and the built-in rules engine). Production needs the ones marked REQUIRED.
# ============================================================

# --- App ---
PORT=3000
# REQUIRED in production: the public address of the site (used in email links)
APP_URL=http://localhost:3000
# REQUIRED in production: long random string used to sign login cookies
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Database (MongoDB Atlas) --- REQUIRED in production (Render's disk is wiped on every deploy)
# Leave empty locally to use the file database (data/pawpal-db.json).
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=pawpal

# --- Owner / administrator ---
# This address becomes an administrator on start-up. If the account doesn't exist, PawPal creates it and
# emails a single-use link (24 h) to choose a password. It is also the default email sender (see MAIL_FROM).
ADMIN_EMAIL=pawpaladmin@gmail.com

# --- Email --- REQUIRED in production for verification, password reset and notifications
# The first provider that is configured is used.
# Option A — Brevo (recommended when sending from a Gmail address): https://app.brevo.com/settings/keys/api
#   Verify your sender address under Senders & IPs → Senders first. Free plan: 300 emails/day.
BREVO_API_KEY=
# Option B — Resend (needs a domain you own): https://resend.com/api-keys
RESEND_API_KEY=
# Option C — SMTP. Gmail: smtp.gmail.com / 465 / true + an App Password (blocked on Render's free plan)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender. Defaults to "PawPal <ADMIN_EMAIL>". Must be verified with your email provider.
MAIL_FROM="PawPal <pawpaladmin@gmail.com>"

# --- SMS (phone verification codes) — Twilio Programmable Messaging ---
# https://console.twilio.com → Account SID, Auth Token, and an SMS-capable number (or Messaging Service number)
# Without these: codes appear in the dev mailbox locally; in production phone verification is disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Country code used when someone types a local number such as 0412 345 678
DEFAULT_COUNTRY_CODE=+61

# --- AI (optional) --- Anthropic: https://console.anthropic.com/settings/keys
# Used for lifestyle understanding, match explanations, the chat assistant, pet descriptions,
# application summaries, the shelter assistant and analytics insights.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Alternative: OpenAI is used only if no Anthropic key is set (paid).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# FREE option: Google Gemini — get a key at https://aistudio.google.com/apikey (no card needed).
# Used when neither Anthropic nor OpenAI is set. On the free tier Google may use prompts to improve its
# products; PawPal only ever sends public pet data and what users type into the assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# With neither key, PawPal's rules engine answers from the same live data.

# --- Google Maps (vet finder) — optional ---
# Enable "Places API (New)" and "Maps Embed API", restrict the key to your domain.
GOOGLE_MAPS_API_KEY=

# --- Demo tools ---
# Lets administrators wipe everything and reload demo data from Settings. Set to false in production.
ALLOW_DEMO_RESET=true
